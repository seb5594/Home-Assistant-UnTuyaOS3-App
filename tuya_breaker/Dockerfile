COPY app/ /opt/webapp/
COPY integration/dhcp.sh /opt/webapp/dhcp.sh
COPY run.sh /run.sh
RUN chmod 755 /opt/webapp/dhcp.sh /run.sh
ENV PATH=/opt/venv/bin:$PATH PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1 UNTUYAOS3_SKIP_INSTALL=1
